# Session secret used to sign the session cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: Google OAuth (Sign in with Google). If unset, Google sign-in is hidden.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Launch switch: sending invitations is free by default (good for growing your first users
# without a payment wall). Set to "false" once you're ready to charge — the Stripe/token
# code underneath is untouched and starts working again immediately, no redeploy of code.
FREE_MODE=true

# Optional: Stripe (£1.99 charge per invitation sent) — only matters once FREE_MODE=false.
# If unset at that point, sending is disabled with a clear message instead of silently
# letting invites through for free.
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Optional but recommended for production: verifies webhook calls really came from Stripe.
# Get this from `stripe listen --print-secret` locally, or the webhook's signing secret in
# the Stripe dashboard once deployed. Without it, /api/stripe/webhook still works but skips
# signature verification (the /checkout/complete fallback works either way).
STRIPE_WEBHOOK_SECRET=

# Optional: Resend (transactional email). Powers account email confirmation and one-time
# first-date invitations. Without it, confirmation emails are silently skipped (no nagging)
# and one-time invitations are disabled with a clear message — there's no working "send an
# email to a stranger" feature without this configured.
# Get a free key at https://resend.com (no card required) — https://resend.com/api-keys
RESEND_API_KEY=
# The "from" address emails are sent as. Verify your own domain in Resend for a real address
# like hello@meetyah.com (https://resend.com/domains); until then this default only works
# for sending to your own Resend account email (Resend's test-mode restriction).
EMAIL_FROM="MeetYah <onboarding@resend.dev>"
# Where Support-page submissions get forwarded (also requires RESEND_API_KEY above). Replies
# to that email go straight to the person who submitted the form (reply-to is set to them).
SUPPORT_NOTIFY_EMAIL=mhrazavi99@gmail.com

# Your app's public URL. Only used to build links inside emails sent by the Stripe webhook
# (which has no browser request to read an origin from) — set this once you deploy.
PUBLIC_URL=http://localhost:5000

PORT=5000

# Optional: unlocks a simple /admin page (name/email/couple/tokens for every user, plus
# invitations and support requests) — gated by this shared secret, not a real login. Leave
# unset to keep /admin disabled entirely.
ADMIN_SECRET=
