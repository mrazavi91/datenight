# Session secret used to sign the session cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: Google OAuth (Sign in with Google). If unset, Google sign-in is hidden.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Stripe (£1.99 charge per invitation sent). If unset, sending is disabled with
# a clear message instead of silently letting invites through for free.
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Optional but recommended for production: verifies webhook calls really came from Stripe.
# Get this from `stripe listen --print-secret` locally, or the webhook's signing secret in
# the Stripe dashboard once deployed. Without it, /api/stripe/webhook still works but skips
# signature verification (the /checkout/complete fallback works either way).
STRIPE_WEBHOOK_SECRET=

PORT=5000
